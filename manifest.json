{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "1.193.12",
    "description": "__MSG_extDescription__",
    "default_locale": "ru",
    "browser_specific_settings": {
        "gecko": {
            "id": "yandex-direct-helper@c00per01",
            "strict_min_version": "109.0"
        }
    },
    "permissions": [
        "storage"
    ],
    "action": {
        "default_title": "Yandex Direct Helper",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://direct.yandex.ru/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}